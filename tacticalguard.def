Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

%labels
    Author TacticalGuard-LLM
    Version 1.0
    Description TacticalGuard-LLM research container for MILCOM 2026

%environment
    export PYTHONNOUSERSITE=1
    export TOKENIZERS_PARALLELISM=false
    export PYTHONUNBUFFERED=1

%post
    # Avoid interactive prompts
    export DEBIAN_FRONTEND=noninteractive

    # Update and install system deps
    apt-get update -y && apt-get install -y \
        git \
        curl \
        build-essential \
        && rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    python -m pip install --upgrade pip setuptools wheel

    # Install all project dependencies (torch is already in the base image)
    pip install --no-cache-dir \
        "transformers>=4.40.0" \
        "accelerate>=0.27.0" \
        "bitsandbytes>=0.43.0" \
        "sentence-transformers>=2.6.0" \
        "scikit-learn>=1.4.0" \
        "pandas>=2.2.0" \
        "numpy>=1.26.0" \
        "pyyaml>=6.0.1" \
        "tqdm>=4.66.0" \
        "openai>=1.23.0" \
        "matplotlib>=3.8.0" \
        "seaborn>=0.13.0" \
        "jsonlines>=4.0.0" \
        "typing-extensions>=4.14.0" \
        "pytest>=8.0.0"

    # Clone and install CAGE 4 simulator
    cd /opt
    git clone https://github.com/cage-challenge/cage-challenge-4.git
    pip install --no-cache-dir -e /opt/cage-challenge-4/
    # Re-pin typing-extensions in case CAGE downgraded it
    pip install --no-cache-dir -U "typing-extensions>=4.14.0"

    # Final verification
    python -c "import numpy, torch, transformers, sentence_transformers; print('All imports OK')"
    python --version

%runscript
    exec python "$@"

%test
    python -c "
import numpy as np
import torch
import transformers
print('numpy:', np.__version__)
print('torch:', torch.__version__)
print('CUDA available:', torch.cuda.is_available())
print('transformers:', transformers.__version__)
print('Container test PASSED')
"
